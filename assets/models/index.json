{
 "version": 1,
 "units": "1 unit = 1 game tile; +Y up; origin = base centre on the ground (y=0); front faces +Z",
 "conventions": {
  "vertexColors": "COLOR_0 = baked soft AO / moss / foliage shading; multiply into base colour (material.vertexColors = true)",
  "sway": "materials named 'leaves*' or 'cloth_*' are wind-driven; per-vertex weight in attribute _SWAY (three.js: geometry.attributes._sway), 0 = rigid, 1 = free",
  "emissive": "materials named 'emissive_*' glow (emissiveFactor / emissiveTexture) -> bloom layer",
  "alpha": "leaves / cloth_banner use alphaMode MASK (alphaTest 0.5), double sided",
  "light": "optional [x, y, z] (glTF axes, model space) where the engine should place a flame/light; lightColor = suggested light colour",
  "marker": "optional [x, y, z] anchor for a floating quest marker (clear space above the prop)",
  "lod1": "id of a lower-detail version (<id>_lod1.glb, same materials/textures, ~1/2 the leaf-card fill = leafArea); LOD entries carry lodOf",
  "map": "world-2 kits: map id the prop belongs to; kind = tree|rock|decor|building|setpiece|light|wall|pillar|walkway|edge (trees with a map prefix are still kind 'tree': use it instead of the id prefix for Lambert/occluder choices)",
  "kits": "optional texture-sharing packs: kit_<name>.glb holds every model of the family as a root node named by its id; each texture is stored once. The per-id .glb files stay complete and self-contained."
